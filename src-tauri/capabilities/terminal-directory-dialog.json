{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "terminal-directory-dialog",
  "description": "Allow the local workspace and terminal pages to open a native directory picker",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:8117/__recorder",
      "http://127.0.0.1:8117/__recorder/",
      "http://127.0.0.1:8117/__recorder/*"
